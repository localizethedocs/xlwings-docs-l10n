#: ../../../api/top_level_functions.rst:1
msgid ""
"Opens a new workbook and displays an object on its first sheet by default. "
"If you provide a sheet object, it will clear the sheet before displaying the "
"object on the existing sheet."
msgstr ""

#: ../../../api/top_level_functions.rst:6
msgid ""
"Only use this in an interactive context like e.g., a Jupyter notebook! Don't "
"use this in a script as it depends on the active book."
msgstr ""

#: ../../../../xlwings/__init__.py:docstring of xlwings.main.view:13
msgid ""
"the object to display, e.g. numbers, strings, lists, numpy arrays, pandas "
"DataFrames"
msgstr ""

#: ../../../../xlwings/__init__.py:docstring of xlwings.main.view:15
msgid ""
"Sheet object. If none provided, the first sheet of a new workbook is used."
msgstr ""

#: ../../../../xlwings/__init__.py:docstring of xlwings.main.view:16
msgid ""
"If your object is a pandas DataFrame, by default it is formatted as an Excel "
"Table"
msgstr ""

