#: ../../../api/top_level_functions.rst:2
msgid "Top-level functions"
msgstr ""

#: ../../../api/top_level_functions.rst:1
msgid ""
"Loads the selected cell(s) of the active workbook into a pandas DataFrame. "
"If you select a single cell that has adjacent cells, the range is auto-"
"expanded (via current region) and turned into a pandas DataFrame. If you "
"don't have pandas installed, it returns the values as nested lists."
msgstr ""

#: ../../../api/top_level_functions.rst:7
msgid ""
"Only use this in an interactive context like e.g. a Jupyter notebook! Don't "
"use this in a script as it depends on the active book."
msgstr ""

#: ../../../api/top_level_functions.rst:0
msgid "Parameters"
msgstr ""

#: ../../../../xlwings/__init__.py:docstring of xlwings.main.load:14
msgid ""
"Defines the number of columns on the left that will be turned into the "
"DataFrame's index"
msgstr ""

#: ../../../../xlwings/__init__.py:docstring of xlwings.main.load:16
msgid ""
"Defines the number of rows at the top that will be turned into the "
"DataFrame's columns"
msgstr ""

#: ../../../../xlwings/__init__.py:docstring of xlwings.main.load:18
#: xlwings.main.view:19
msgid "Chunks the loading of big arrays."
msgstr ""

