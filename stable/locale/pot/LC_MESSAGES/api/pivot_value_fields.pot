#: ../../../api/pivot_value_fields.md:1
msgid "PivotValueFields"
msgstr ""

#: ../../../api/pivot_value_fields.md:1
msgid ""
"The fields in the *Values* area of a pivot table, i.e. `pt.values`. "
"Iteration follows the field order."
msgstr ""

#: ../../../api/pivot_value_fields.md:1
msgid ""
"Adds a source field to the values area, after the existing value fields. The "
"same source field can be added more than once, e.g. as a sum and as a count."
msgstr ""

#: ../../../api/pivot_value_fields.md:0
msgid "Parameters"
msgstr ""

#: ../../../../xlwings/main.py:docstring of xlwings.main.PivotValueFields.add:8
msgid ""
"Name of the source field, see :attr:`PivotTable.field_names <xlwings."
"PivotTable.field_names>`."
msgstr ""

#: ../../../../xlwings/main.py:docstring of
#: xlwings.main.PivotValueFields.add:10
msgid ""
"Summary function, see :attr:`PivotValueField.function <xlwings."
"PivotValueField.function>`. Defaults to Excel's choice: ``\"sum\"`` for "
"numeric fields, ``\"count\"`` otherwise."
msgstr ""

#: ../../../../xlwings/main.py:docstring of
#: xlwings.main.PivotValueFields.add:14
msgid ""
"Caption, e.g. ``\"Total Sales\"``. Defaults to Excel's caption, e.g. ``\"Sum "
"of Sales\"``. Excel rejects a name that equals the name of a source field."
msgstr ""

#: ../../../../xlwings/main.py:docstring of
#: xlwings.main.PivotValueFields.add:17
msgid "Number format, e.g. ``\"#,##0.00\"``."
msgstr ""

#: ../../../api/pivot_value_fields.md:0
msgid "Return type"
msgstr ""

#: ../../../api/pivot_value_fields.md:1
msgid "Returns the pivot table the area belongs to."
msgstr ""
