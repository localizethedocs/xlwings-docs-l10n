msgid "Examples"
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "Whether cell values remain visible for a data bar or icon set."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "Whether lower-priority rules stop when this rule matches."
msgstr ""

#: ../../../api/conditional_format.md:3
msgid ""
"`None` is returned for color scales, data bars and icon sets, which don't "
"have stop-if-true behavior."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The ordered criterion types for a visual rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:3
msgid ""
"Color scales include all criteria, data bars include the lower and upper "
"bounds, and icon sets include only the effective thresholds between icons."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid ""
"The values corresponding to {attr}`threshold_types <xlwings."
"ConditionalFormat.threshold_types>`."
msgstr ""

#: ../../../api/conditional_format.md:4
msgid ""
"Criteria such as `\"automatic\"`, `\"lowest_value\"` and `\"highest_value\"` "
"have a value of `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The normalized rule type."
msgstr ""

#: ../../../api/conditional_format.md:3
msgid ""
"Rule types outside the initially supported cell-value, custom-formula, color-"
"scale, data-bar and icon-set families are reported as `\"unknown\"` rather "
"than omitted."
msgstr ""
