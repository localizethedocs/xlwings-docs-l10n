#: ../../../api/conditional_format.md:1
msgid "ConditionalFormat"
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "Represents one conditional-format rule that applies to a range."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The positive fill color of a data-bar rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The ordered colors of a color-scale rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:3
msgid "Colors run from the minimum criterion to the maximum criterion."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "Delete this complete rule from all ranges to which it applies."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The rule's fill color as an RGB tuple, or `None` if unset."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The rule's bold setting, or `None` if it doesn't set bold."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The rule's font color as an RGB tuple, or `None` if unset."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The rule's italic setting, or `None` if it doesn't set italic."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The formula for a custom-formula rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The first operand for a cell-value rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The second operand for a between/not-between rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "Whether a data bar uses a gradient fill, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The built-in style of an icon-set rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "The comparison operator for a cell-value rule, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "Whether an icon set's icon order is reversed, otherwise `None`."
msgstr ""

#: ../../../api/conditional_format.md:1
msgid "Change selected attributes of this rule in place."
msgstr ""

#: ../../../api/conditional_format.md:3
msgid ""
"Omitted attributes remain unchanged. Cell-value rules accept `operator`, "
"`formula1` and `formula2`; custom-formula rules accept `formula`. Formatting "
"and `stop_if_true` apply to either family. Other rule types can't be edited "
"by this initial API."
msgstr ""

#: ../../../../xlwings/main.py:docstring of
