#: ../../../converters.md:33
msgid "Default Converter"
msgstr ""

#: ../../../converters.md:35
msgid ""
"If no options are set, the following default conversions are applied when "
"accessing `Range.value`:"
msgstr ""

#: ../../../converters.md:37
msgid "Numbers -> `floats`"
msgstr ""

#: ../../../converters.md:38
msgid "Text -> `str`"
msgstr ""

#: ../../../converters.md:39
msgid "Date and/or time -> `datetime`"
msgstr ""

#: ../../../converters.md:40
msgid "`TRUE` or `FALSE` -> `bool`"
msgstr ""

#: ../../../converters.md:41
msgid "Empty cell -> `None`"
msgstr ""

#: ../../../converters.md:42
msgid "Windows only: Currency -> `Decimal`, truncated to 4 decimals"
msgstr ""

#: ../../../converters.md:44
msgid ""
"Columns/rows are read in as lists, e.g. `[None, 1.0, 'a string']` and 2d "
"cell ranges are read in as list of lists, e.g. `[[None, 1.0, 'a string'], "
"[None, 2.0, 'another string']]`."
msgstr ""

